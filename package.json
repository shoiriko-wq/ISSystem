{
  "name": "issystem",
  "version": "1.0.0",
  "description": "職員室情報共有システム (ISSystem) バックエンド",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "cert:gen": "node scripts/create-ca.mjs",
    "pretest": "node scripts/init-db.js && node scripts/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:db:smoke": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage --coverageReporters=text",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "db:drop-general-chat": "node scripts/migrate-chat-drop-general.mjs",
    "db:mail-folders": "node scripts/migrate-mail-folders.mjs",
    "db:create": "node scripts/create-db.js",
    "db:tables": "node scripts/list-tables.js",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "seed:chat": "node scripts/seed-chat.mjs",
    "audit:check": "node scripts/audit-logs.mjs --check-rotation",
    "api:check": "node scripts/api-smoke-test.js",
    "test:socket-auth": "node --env-file=.env scripts/test-socket-auth.mjs",
    "test:rbac": "node scripts/test-rbac-user-admin.mjs",
    "test:ratelimit": "node --env-file=.env scripts/test-login-ratelimit.mjs",
    "test:logsecurity": "node --env-file=.env scripts/test-log-security.mjs",
    "test:api:mail-defaults": "node scripts/test-mail-defaults.mjs",
    "test:api:mail-test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/mail.test.js",
    "rotate:mail-key": "node --env-file=.env scripts/rotate-mail-enc-key.mjs",
    "test:ui:modal": "node scripts/test-modal-close.mjs",
    "test:ui:news-share": "node scripts/test-news-share-modal.mjs",
    "test:ui:fx": "node scripts/test-dash-fx.mjs",
    "test:ui:frames": "node scripts/test-frame-rules.mjs",
    "test:ui:scan": "node scripts/scan-frames.mjs",
    "test:ui:header-frames": "node scripts/test-header-frames.mjs",
    "test:ui:audit": "node scripts/test-ui-audit.mjs",
    "test:ui:chrome": "node scripts/test-chrome-contrast.mjs",
    "test:ui:contrast": "node scripts/contrast-scan.mjs",
    "test:ui:contrast-plain": "set SCAN_TARGETS=plain&& node scripts/contrast-scan.mjs",
    "test:ui:nav": "node scripts/check-nav-shapes.mjs",
    "test:ui:sidebar-push": "node scripts/test-sidebar-push.mjs",
    "test:ui:sidebar": "node scripts/test-sidebar-collapse.mjs",
    "test:ui:bulletin": "node scripts/test-bulletin-split.mjs",
    "test:ui:unread": "node scripts/test-dashboard-unread.mjs",
    "test:ui:schedule": "node scripts/test-schedule-month-nav.mjs",
    "test:ui:bulletin-search": "node scripts/test-bulletin-search-all-days.mjs",
    "test:ui:bulletin-unread": "node scripts/test-bulletin-unread-all-days.mjs",
    "test:ui:chat": "node scripts/test-chat-unread.mjs",
    "test:ui:chat-ui": "node scripts/test-chat-ui.mjs",
    "test:ui:chat-socket": "node scripts/test-chat-socket.mjs",
    "test:ui:coverage": "node scripts/test-coverage.mjs",
    "test:ui:facility": "node scripts/test-facility-master.mjs",
    "test:ui:facility-order": "node scripts/test-facility-order.mjs",
    "test:ui:facility-header-sticky": "node scripts/test-facility-header-sticky.mjs",
    "test:ui:mail": "node scripts/test-mail-setup.mjs",
    "test:ui:https": "node scripts/test-https-ca.mjs",
    "test:ui:timeline": "node scripts/test-facility-timeline.mjs",
    "test:ui:exambasic": "node scripts/test-exam-basic-columns.mjs",
    "test:ui:examaddtop": "node scripts/test-exam-basic-add-top.mjs",
    "test:ui:seating": "node scripts/test-ui-seating.mjs",
    "test:ui:block": "node scripts/test-block-ui.mjs",
    "test:ui:bulletin-title-pane": "node scripts/test-bulletin-title-pane-width.mjs",
    "test:ui:bulletin-unread-btn-pos": "node scripts/test-bulletin-unread-btn-pos.mjs",
    "test:ui:all": "npm run test:ui:https && npm run test:ui:modal && npm run test:ui:news-share && npm run test:ui:fx && npm run test:ui:frames && npm run test:ui:audit && npm run test:ui:chrome && npm run test:ui:contrast && npm run test:ui:contrast-plain && npm run test:ui:scan && npm run test:ui:header-frames && npm run test:ui:nav && npm run test:ui:sidebar && npm run test:ui:sidebar-push && npm run test:ui:facility-header-sticky && npm run test:ui:facility-order && npm run test:ui:bulletin && npm run test:ui:unread && npm run test:ui:bulletin-search && npm run test:ui:bulletin-unread && npm run test:ui:bulletin-unread-btn-pos && npm run test:ui:bulletin-title-pane && npm run test:ui:schedule && npm run test:ui:chat && npm run test:ui:facility && npm run test:ui:timeline && npm run test:ui:mail && npm run test:ui:exambasic && npm run test:ui:examaddtop && npm run test:ui:seating && npm run test:ui:block",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify": "npm test && npm run verify:docs",
    "verify:all": "npm test && npm run api:check && npm run test:ui:all && npm run verify:docs",
    "postinstall": "node scripts/setup-git-hooks.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "keywords": [
    "issystem",
    "school-management",
    "express",
    "socket.io"
  ],
  "author": "",
  "license": "ISC",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.kilo/"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "puppeteer-core": "^25.16.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}