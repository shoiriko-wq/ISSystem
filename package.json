{
  "name": "issystem",
  "version": "1.0.0",
  "description": "職員室情報共有システム (ISSystem) バックエンド",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "cert:gen": "node scripts/create-ca.mjs",
    "pretest": "node scripts/init-db.js && node scripts/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "db:create": "node scripts/create-db.js",
    "api:check": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/api-smoke-test.js",
    "test:socket-auth": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node --env-file=.env scripts/test-socket-auth.mjs",
    "test:rbac": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-rbac-user-admin.mjs",
    "test:ratelimit": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node --env-file=.env scripts/test-login-ratelimit.mjs",
    "test:logsecurity": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node --env-file=.env scripts/test-log-security.mjs",
    "rotate:mail-key": "node --env-file=.env scripts/rotate-mail-enc-key.mjs",
    "test:ui:modal": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-modal-close.mjs",
    "test:ui:news-share": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-news-share-modal.mjs",
    "test:ui:fx": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-dash-fx.mjs",
    "test:ui:frames": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-frame-rules.mjs",
    "test:ui:scan": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/scan-frames.mjs",
    "test:ui:header-frames": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-header-frames.mjs",
    "test:ui:audit": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-ui-audit.mjs",
    "test:ui:chrome": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-chrome-contrast.mjs",
    "test:ui:contrast": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/contrast-scan.mjs",
    "test:ui:contrast-plain": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt SCAN_TARGETS=plain node scripts/contrast-scan.mjs",
    "test:ui:nav": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/check-nav-shapes.mjs",
    "test:ui:sidebar-push": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-sidebar-push.mjs",
    "test:ui:sidebar": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-sidebar-collapse.mjs",
    "test:ui:bulletin": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-bulletin-split.mjs",
    "test:ui:unread": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-dashboard-unread.mjs",
    "test:ui:schedule": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-schedule-month-nav.mjs",
    "test:ui:bulletin-search": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-bulletin-search-all-days.mjs",
    "test:ui:chat": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-chat-unread.mjs",
    "test:ui:facility": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-facility-master.mjs",
    "test:ui:facility-order": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-facility-order.mjs",
    "test:ui:facility-header-sticky": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-facility-header-sticky.mjs",
    "test:ui:mail": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-mail-setup.mjs",
    "test:api:mail-defaults": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-mail-defaults.mjs",
    "test:api:mail-test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/mail.test.js",
    "test:ui:https": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-https-ca.mjs",
    "test:ui:all": "export NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt && npm run test:ui:https && npm run test:ui:modal && npm run test:ui:news-share && npm run test:ui:fx && npm run test:ui:frames && npm run test:ui:audit && npm run test:ui:chrome && npm run test:ui:contrast && npm run test:ui:contrast-plain && npm run test:ui:scan && npm run test:ui:header-frames && npm run test:ui:nav && npm run test:ui:sidebar && npm run test:ui:facility-header-sticky && npm run test:ui:facility-order && npm run test:ui:bulletin && npm run test:ui:unread && npm run test:ui:bulletin-search && npm run test:ui:chat && npm run test:ui:facility && npm run test:ui:timeline && npm run test:ui:mail && npm run test:ui:exambasic && npm run test:ui:seating",
    "test:ui:timeline": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-facility-timeline.mjs",
    "test:ui:exambasic": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-exam-basic-columns.mjs",
    "test:ui:seating": "NODE_EXTRA_CA_CERTS=$(pwd)/certs/issystem-ca.crt node scripts/test-ui-seating.mjs",
    "db:tables": "node scripts/list-tables.js"
  },
  "keywords": [
    "issystem",
    "school-management",
    "express",
    "socket.io"
  ],
  "author": "",
  "license": "ISC",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.kilo/"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "puppeteer-core": "^25.16.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}
