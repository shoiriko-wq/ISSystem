{
  "name": "issystem",
  "version": "1.0.0",
  "description": "職員室情報共有システム (ISSystem) バックエンド",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "db:create": "node scripts/create-db.js",
    "api:check": "node scripts/api-smoke-test.js",
    "test:ui:modal": "node scripts/test-modal-close.mjs",
    "test:ui:frames": "node scripts/test-frame-rules.mjs",
    "test:ui:scan": "node scripts/scan-frames.mjs",
    "test:ui:audit": "node scripts/test-ui-audit.mjs",
    "test:ui:nav": "node scripts/check-nav-shapes.mjs",
    "test:ui:all": "npm run test:ui:modal && npm run test:ui:frames && npm run test:ui:audit && npm run test:ui:scan && npm run test:ui:nav",
    "db:tables": "node scripts/list-tables.js"
  },
  "keywords": [
    "issystem",
    "school-management",
    "express",
    "socket.io"
  ],
  "author": "",
  "license": "ISC",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.kilo/"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "puppeteer-core": "^25.16.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}
