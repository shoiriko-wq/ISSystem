# =====================================================================
# ISSystem 環境変数テンプレート (.env.example)
# 使い方: cp .env.example .env  → 必要な値だけ書き換える
# ※ .env は .gitignore 済み（コミットしない）。このテンプレートはコミットする。
# ※ 読み込みは package.json のスクリプトが `node --env-file=.env` で行う
#   （Node 20.6+ の標準機能。dotenv は不要）
# =====================================================================

# --- 1. サーバー基本設定 -------------------------------------------
# development | production | test
NODE_ENV=development
# 非安全ポート（HTTP）: CA証明書の配布専用。アプリ/APIアクセスは 426 で拒否される
PORT=3000
# 監視ホスト（0.0.0.0 = 全インターフェース, 127.0.0.1 = ローカルのみ）
HOST=0.0.0.0
# Secure（HTTPS/WSS）ポートと監視ホスト
SSL_PORT=3443
SSL_HOST=0.0.0.0
# 証明書パス（.env と同じ階層の certs/。npm run cert:gen が生成）とSANホスト
SSL_DIR=certs
SSL_KEY=certs/server.key
SSL_CERT=certs/server.pem
SSL_CA=certs/issystem-ca.pem
SSL_HOSTS=localhost,issystem.local,issystem,127.0.0.1,::1
# 本番では 80 → CAページ専用、443 → HTTPS/WSS にするのが定石
# 非HTTPで CA ページへ来た際に「安全接続で開く」ボタンを作るためのURL基点（未設定なら https://host:port/）
SSL_CA_PAGE_BASE=https://127.0.0.1:3443
# Express の CORS 許可 Origin（HTTPS origin のみ許可）
CORS_ORIGIN=https://127.0.0.1:3443,https://localhost:3443
# Socket.io の CORS 許可 Origin（同一サーバー提供なら * で可、分離開発なら例: https://localhost:5173）
CLIENT_ORIGIN=https://127.0.0.1:3443,https://localhost:3443

# --- 2. 認証・セキュリティ ---------------------------------------
# 【重要】JWT_SECRET はパスワードハッシュのソルトとしても使われている
# （scripts/seed.js / src/services/auth.service.js）。
# 変更した場合は必ず `npm run db:seed` を再実行すること。
# 本番では `openssl rand -hex 32` で採ること（下記は開発用の既定値）。
JWT_SECRET=is_system_secret_key_2026_default_jwt
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# --- 3. データベース ---------------------------------------------
# 接続タイプ: 'postgres'（PostgreSQL 18.6 / issystem データベース）
DB_TYPE=postgres
# pg ライブラリが直接使用する接続 URI（本番ではパスワードを実値に）
DATABASE_URL=postgresql://postgres:password@localhost:5432/issystem
# 個別指定（URI 上書き・フォールバック用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=issystem
DB_USER=postgres
DB_PASSWORD=password
DB_MAX_CONN=20
# セッションタイムゾーン（JST）
DB_TIMEZONE=Asia/Tokyo

# --- 4. リアルタイム通信・排他制御 --------------------------------
# 無操作で自動解放までの時間（ミリ秒, 180000 = 3分）
LOCK_TIMEOUT_MS=180000

# --- 5. 席替え最適化バッチ -------------------------------------
# 最適化計算の上限時間（ミリ秒）
OPTIMIZER_MAX_TIME_MS=10000
# ワーカースレッド数
WORKER_THREADS=2

# --- 6. Node クライアント側の CA 信頼（スクリプトからの HTTPS/WSS アクセス）---
# certs/issystem-ca.pem を信頼して HTTPS/WSS に接続するための環境変数
# （スクリプト系 npm script では node 起動時に付与されている）
# NODE_EXTRA_CA_CERTS=./certs/issystem-ca.pem

# --- 7. ストレージ・アップロード ---------------------------------
# config/default.js の既定値はプロジェクト外（../data/uploads）になるため
# プロジェクト内のパスを明示する
UPLOAD_DIR=./data/uploads
# アップロード上限バイト（10485760 = 10MB）
MAX_FILE_SIZE=10485760

# --- 7. ログ ----------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
