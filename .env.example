# =====================================================================
# ISSystem 環境変数テンプレート (.env.example)
# 使い方: cp .env.example .env  → 必要な値だけ書き換える
# ※ .env は .gitignore 済み（コミットしない）。このテンプレートはコミットする。
# ※ 読み込みは package.json のスクリプトが `node --env-file=.env` で行う
#   （Node 20.6+ の標準機能。dotenv は不要）
# =====================================================================

# --- 1. サーバー基本設定 -------------------------------------------
# development | production | test
NODE_ENV=development
# 非安全ポート（HTTP）: CA証明書の配布専用。アプリ/APIアクセスは 426 で拒否される
PORT=3000
# 監視ホスト（0.0.0.0 = 全インターフェース, 127.0.0.1 = ローカルのみ）
HOST=0.0.0.0
# Secure（HTTPS/WSS）ポートと監視ホスト
SSL_PORT=3443
SSL_HOST=0.0.0.0
# 証明書パス（.env と同じ階層の certs/。npm run cert:gen が生成）とSANホスト
SSL_DIR=certs
SSL_KEY=certs/server.key
SSL_CERT=certs/server.pem
SSL_CA=certs/issystem-ca.pem
# サーバー証明書の SAN（Subject Alternative Name）。ブラウザは接続先のホスト名/IP が SAN に
# 無いと警告なしに接続を拒否する（Chrome/Edge/Safari は続行不可）。
# LAN 端末が https://<IPv4>:3443 を開くなら、その IPv4 を必ず含める（IP は DHCP 予約で固定）。
# SSL_HOSTS は scripts/create-ca.mjs も読む（シェル環境変数が優先）。変更後は
# `npm run cert:gen -- --server-only`（CA 再利用＝端末の信頼ストア設定は有効のまま）で再署名。
SSL_HOSTS=localhost,issystem.local,issystem,127.0.0.1,::1
# 本番では 80 → CAページ専用、443 → HTTPS/WSS にするのが定石
# 非HTTPで CA ページへ来た際に「安全接続で開く」ボタンを作るためのURL基点（未設定なら https://host:port/）
SSL_CA_PAGE_BASE=https://127.0.0.1:3443
# Express の CORS 許可 Origin（HTTPS origin のみ許可。wildcard * は使わない）
CORS_ORIGIN=https://127.0.0.1:3443,https://localhost:3443
# Socket.io の CORS 許可 Origin（wildcard * 禁止。LAN 利用者の Origin も列挙する）
CLIENT_ORIGIN=https://127.0.0.1:3443,https://localhost:3443
# Socket 接続ハンドシェイクの Origin 許可リスト（socket.middleware.js が照合）
SOCKET_CORS_ORIGINS=https://127.0.0.1:3443,https://localhost:3443

# --- 2. 認証・セキュリティ ---------------------------------------
# 2026/11/8 監査 Critical 対策: JWT_SECRET は既知の既定値を禁止
# （is_system_secret_key_2026_default_jwt / dev-secret-key-change-in-production）。
# 32文字以上のランダム値が必須で、未設定・既定値・短値では config/default.js が
# 起動時に throw する（fail-fast）。生成: `openssl rand -hex 32`
# パスワードハッシュは bcrypt のみ（平文/SHA-256 フォールバックは撤去済み）。
JWT_SECRET=CHANGE_ME_32bytes_random_openssl_rand_hex_32
# メール接続パスワードの AES-256-GCM 暗号化キーの基（JWT とは必ず別値）。
# 生成: `openssl rand -hex 32`。変更時は `npm run rotate:mail-key` で再暗号化。
MAIL_ENC_SECRET=CHANGE_ME_32bytes_random_openssl_rand_hex_32
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# --- 3. データベース ---------------------------------------------
# 接続タイプ: 'postgres'（PostgreSQL 18.6 / issystem データベース）
DB_TYPE=postgres
# pg ライブラリが直接使用する接続 URI（本番ではパスワードを実値に）
DATABASE_URL=postgresql://postgres:password@localhost:5432/issystem
# 個別指定（URI 上書き・フォールバック用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=issystem
DB_USER=postgres
DB_PASSWORD=password
DB_MAX_CONN=20
# セッションタイムゾーン（JST）
DB_TIMEZONE=Asia/Tokyo

# --- 4. リアルタイム通信・排他制御 --------------------------------
# 無操作で自動解放までの時間（ミリ秒, 180000 = 3分）
LOCK_TIMEOUT_MS=180000

# --- 5. 席替え最適化バッチ -------------------------------------
# 最適化計算の上限時間（ミリ秒）
OPTIMIZER_MAX_TIME_MS=10000
# ワーカースレッド数
WORKER_THREADS=2

# --- 6. Node クライアント側の CA 信頼（スクリプトからの HTTPS/WSS アクセス）---
# certs/issystem-ca.pem を信頼して HTTPS/WSS に接続するための環境変数
# （スクリプト系 npm script では node 起動時に付与されている）
# NODE_EXTRA_CA_CERTS=./certs/issystem-ca.pem

# --- 7. ストレージ・アップロード ---------------------------------
# config/default.js の既定値はプロジェクト外（../data/uploads）になるため
# プロジェクト内のパスを明示する
UPLOAD_DIR=./data/uploads
# アップロード上限バイト（10485760 = 10MB）
MAX_FILE_SIZE=10485760

# --- 7. ログ ----------------------------------------------------
# debug | info | warn | error
# アプリログ保持設定 (v3.0.8, §15 監査 #5 ログ権限/保存期間管理)
# 監査ログ保持日数 (cron 3:00 AM が audit_logs / system_audit_logs を削除、既定 90日)
AUDIT_RETENTION_DAYS=90
# アクセスログ出力ディレクトリ (既定 data/logs、ディレクトリ 700 / ファイル 600、日次ローテーション、同上日数で保持)
LOG_DIR=data/logs

LOG_LEVEL=info

# --- 8. メール接続設定の初期値 (IMAP / SMTP) -------------------
# 実際のサーバー名・ポートは .env（Git にコミットしない秘匿情報）にだけ書く。
# このテンプレートには実値を書かない（空 = 未設定扱い、UI で入力）
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
# 暗号化モードの初期値 (none = 暗号化なし / starttls / tls = TLS 直結)
# 既定は none（TLS を使用しない）。実値はこのテンプレートに書かない（空 = 既定の none）。
MAIL_IMAP_TLS=
MAIL_SMTP_TLS=
# 受信フォルダと送信済みフォルダの初期値 (IMAP フォルダ名 / 空 = INBOX と Sent)
MAIL_INBOX_FOLDER=
MAIL_SENT_FOLDER=
# 差出人名の初期値 (SMTP 送信時の表示名 / 空 = 差出人名なし)
MAIL_DISPLAY_NAME=
# 接続テスト・送受信のタイムアウト (ミリ秒 / 既定 12000)
MAIL_TIMEOUT_MS=12000
